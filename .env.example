NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL="postgresql://ankuaru_market_user:YOUR_URL_ENCODED_PASSWORD@104.236.64.33:5432/ankuaru_market"
DATABASE_POOL_SIZE=10
SESSION_TTL_SECONDS=86400
# Enable only when using the existing demo frontend locally.
ENABLE_DEMO_AUTH=false
# Production phone OTP requires a 32+ character secret and an SMS gateway.
# PHONE_OTP_SECRET=
# SMS_DELIVERY_URL=
# SMS_DELIVERY_TOKEN=
# SMS_SENDER_ID=
# GeezSMS delivers codes when set (takes precedence over SMS_DELIVERY_URL).
# Only Ethiopian (+251) numbers can then be verified.
# GEEZ_TOKEN=
# GEEZ_SHORTCODE_ID=
# "Continue with Telegram" turns on once both are set. Create the bot with
# @BotFather and register the site's domain with /setdomain (not localhost).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# Database connection tuning (optional). A remote database may need a longer
# connect timeout; statements running longer than the statement timeout are
# cancelled and the request returns 503 query_timeout.
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=10000

# Log API requests slower than this many milliseconds (optional).
# SLOW_REQUEST_MS=1000

# Behind a reverse proxy (nginx, a load balancer), set how many proxies to
# trust so rate limits use the real client address (optional).
# TRUST_PROXY=1

# Legacy site sync: the API re-imports new posts and listings from the legacy
# API on this interval in minutes (default 30; 0 turns it off).
# LEGACY_SYNC_INTERVAL_MINUTES=30
# LEGACY_API_BASE_URL=https://backend.ankuaru.com/api
# LEGACY_IMPORT_SINCE=2026-10-01T00:00:00+03:00
# LEGACY_NEWS_SINCE=
# LEGACY_SKIP_LISTINGS=1
